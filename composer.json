{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework de Geoestadística.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^3.5",
        "guzzlehttp/guzzle": "^7.8",
        "hnhdigital-os/laravel-git-info": "dev-master",
        "laracasts/flash": "^3.2.6",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.45",
        "laravel/tinker": "^2.10",
        "maatwebsite/excel": "^3.1.70",
        "monolog/monolog": "^3.0",
        "nunomaduro/collision": "^8.0",
        "phpoffice/phpspreadsheet": "^1.30.7",
        "predis/predis": "^1.1",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-permission": "^7.0",
        "symfony/console": "^7.2",
        "symfony/http-client": "^7.2",
        "symfony/mailer": "^7.2",
        "symfony/mailgun-mailer": "^7.2",
        "symfony/postmark-mailer": "^7.2",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.24",
        "laravel/ui": "^4.0",
        "mockery/mockery": "^1.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeds/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
